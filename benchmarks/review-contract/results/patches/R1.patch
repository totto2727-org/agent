diff --git a/test/configuration.test.mjs b/test/configuration.test.mjs
new file mode 100644
index 0000000..da1af43
--- /dev/null
+++ b/test/configuration.test.mjs
@@ -0,0 +1,82 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { parseArgs } from "../cli.mjs";
+import { peek } from "../runtime.mjs";
+
+test("CLI exposes only timeout with its default and explicit values", () => {
+  assert.deepEqual(parseArgs([]), { timeout: 500 });
+  assert.deepEqual(parseArgs(["--timeout", "1"]), { timeout: 1 });
+  assert.deepEqual(parseArgs(["--timeout", "900"]), { timeout: 900 });
+});
+
+for (const [option, formerDefault, otherValue] of [
+  ["--encoding", "utf8", "latin1"],
+  ["--retries", "0", "2"],
+  ["--format", "json", "text"],
+]) {
+  test(`${option} is unknown even with its former default`, () => {
+    for (const args of [
+      [option],
+      [option, formerDefault],
+      [option, otherValue],
+      ["--timeout", "900", option, formerDefault],
+      [`${option}=${formerDefault}`],
+    ]) {
+      assert.throws(() => parseArgs(args), { message: "Unknown option" });
+    }
+  });
+}
+
+test("CLI rejects unknown options and malformed option names", () => {
+  for (const option of ["--unknown", "--authorization", "xxtimeout", "timeout"]) {
+    assert.throws(() => parseArgs([option, "500"]), { message: "Unknown option" });
+  }
+});
+
+test("CLI keeps positive-integer timeout validation", () => {
+  for (const value of [undefined, "", "0", "-1", "1.5", "NaN", "Infinity", "abc"]) {
+    const args = value === undefined ? ["--timeout"] : ["--timeout", value];
+    assert.throws(() => parseArgs(args), { message: "Invalid timeout" });
+  }
+});
+
+test("runtime leaves decoding, retries, and unmanaged concurrency to transport defaults", async () => {
+  let request;
+  let defaults;
+  const transport = async (value) => {
+    request = value;
+    const { encoding = "utf8", retries = 0, concurrency = 8 } = value;
+    defaults = { encoding, retries, concurrency };
+    return { label: Buffer.from("箱 📦 café").toString(encoding) };
+  };
+  const output = await peek(transport);
+  assert.deepEqual(request, { timeout: 500, authorization: undefined });
+  assert.deepEqual(defaults, { encoding: "utf8", retries: 0, concurrency: 8 });
+  assert.equal(output, '{"label":"箱 📦 café"}');
+  assert.deepEqual(JSON.parse(output), { label: "箱 📦 café" });
+});
+
+test("runtime does not forward removed overrides and retains managed quota and authorization", async () => {
+  let request;
+  const output = await peek(
+    async (value) => {
+      request = value;
+      return { label: "箱" };
+    },
+    { ...parseArgs(["--timeout", "900"]), profile: "managed", encoding: "latin1", retries: 3, format: "text" },
+    "Bearer fixture",
+  );
+  assert.deepEqual(request, { timeout: 900, authorization: "Bearer fixture", concurrency: 2 });
+  assert.equal(output, '{"label":"箱"}');
+});
+
+test("runtime rejects invalid timeout before calling transport", async () => {
+  let calls = 0;
+  for (const timeout of [0, -1, 1.5, NaN, Infinity, "500"]) {
+    await assert.rejects(
+      peek(async () => { calls += 1; }, { timeout, profile: "managed" }),
+      { message: "Invalid timeout" },
+    );
+  }
+  assert.equal(calls, 0);
+});
