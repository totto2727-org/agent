diff --git a/test/records.test.mjs b/test/records.test.mjs
new file mode 100644
index 0000000..e0cfa33
--- /dev/null
+++ b/test/records.test.mjs
@@ -0,0 +1,45 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { render } from "../render.mjs";
+import { authorize } from "../auth.mjs";
+import { releaseCheck } from "../ci-contract.mjs";
+
+for (const format of ["text", "json"]) {
+  test(`${format}: LF and CRLF delimiters share record semantics`, () => {
+    const records = [" two ", "one", " ", "bare\rCR", "tail\r", "\r"];
+    const input = "\r\n two \r\n\r\none\n\n \r\nbare\rCR\r\ntail\r\r\n\r\r\n";
+    const expected = format === "json" ? JSON.stringify(records) : records.join("\n");
+    assert.equal(render(input, format, "Bearer fixture", "fixture"), expected);
+    assert.equal(render("bare\rCR\rtail\r", format, "Bearer fixture", "fixture"),
+      format === "json" ? '["bare\\rCR\\rtail\\r"]' : "bare\rCR\rtail\r");
+    assert.equal(render("\n\r\n\n", format, "Bearer fixture", "fixture"),
+      format === "json" ? "[]" : "");
+    assert.equal(render("", format, "Bearer fixture", "fixture"),
+      format === "json" ? "[]" : "");
+  });
+
+  test(`${format}: authorization still precedes empty-input rendering`, () => {
+    for (const input of ["", "\n\r\n", "one\r\n"]) {
+      for (const token of ["", "fixture", "bearer fixture", "Bearer fixture ", "Bearer wrong"]) {
+        assert.throws(() => render(input, format, token, "fixture"), { message: "Unauthorized" });
+      }
+      for (const expected of ["", undefined, null, 1]) {
+        assert.throws(() => render(input, format, "Bearer fixture", expected), { message: "Unauthorized" });
+      }
+    }
+  });
+}
+
+test("public authorization and format selection remain exact", () => {
+  assert.equal(authorize("Bearer fixture", "fixture"), undefined);
+  assert.throws(() => authorize("bearer fixture", "fixture"), { message: "Unauthorized" });
+  for (const format of ["yaml", "JSON", "Text", undefined]) {
+    assert.throws(() => render("", format, "Bearer fixture", "fixture"), { message: "Unknown format" });
+    assert.throws(() => render("", format, "", "fixture"), { message: "Unauthorized" });
+  }
+});
+
+test("release check remains dependency-free Node 24 with builtin tests", () => {
+  assert.deepEqual(releaseCheck, { nodeMajor: 24, command: ["node", "--test", "test/*.test.mjs"], install: false });
+  assert.ok(Object.isFrozen(releaseCheck));
+});
