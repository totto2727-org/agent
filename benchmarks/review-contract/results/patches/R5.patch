diff --git a/test/line-endings.test.mjs b/test/line-endings.test.mjs
new file mode 100644
index 0000000..c693e93
--- /dev/null
+++ b/test/line-endings.test.mjs
@@ -0,0 +1,38 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { render } from "../render.mjs";
+
+const cases = [
+  { name: "LF", input: "two\n\none\n", records: ["two", "one"] },
+  { name: "CRLF", input: "two\r\n\r\none\r\n", records: ["two", "one"] },
+  { name: "mixed delimiters", input: "\r\ntwo\r\n\none\nthree\r\n", records: ["two", "one", "three"] },
+  { name: "spaces", input: " two \r\n \n\r\none \n", records: [" two ", " ", "one "] },
+  { name: "bare CR inside a name", input: "two\rone\r\nnext", records: ["two\rone", "next"] },
+  { name: "bare CR at record edges", input: "\rfirst\nlast\r", records: ["\rfirst", "last\r"] },
+  { name: "CR before a CRLF delimiter", input: "one\r\r\ntwo", records: ["one\r", "two"] },
+  { name: "bare CR only", input: "\r", records: ["\r"] },
+  { name: "empty input", input: "", records: [] },
+  { name: "empty records only", input: "\r\n\n\r\n", records: [] },
+];
+
+for (const format of ["text", "json"]) {
+  for (const { name, input, records } of cases) {
+    test(`${format}: ${name}`, () => {
+      const expected = format === "json" ? JSON.stringify(records) : records.join("\n");
+      assert.equal(render(input, format, "Bearer fixture", "fixture"), expected);
+    });
+  }
+
+  test(`${format}: empty input still requires exact authorization`, () => {
+    for (const token of ["", "fixture", "bearer fixture", "Bearer fixture ", "Bearer other"]) {
+      assert.throws(() => render("", format, token, "fixture"), { message: "Unauthorized" });
+    }
+    assert.throws(() => render("", format, "Bearer ", ""), { message: "Unauthorized" });
+    assert.throws(() => render("", format, "Bearer undefined", undefined), { message: "Unauthorized" });
+  });
+}
+
+test("format selection and authorization order remain unchanged", () => {
+  assert.throws(() => render("", "yaml", "Bearer fixture", "fixture"), { message: "Unknown format" });
+  assert.throws(() => render("", "yaml", "", "fixture"), { message: "Unauthorized" });
+});
